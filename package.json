{
  "name": "draft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "part-d:test": "tsx --test src/lib/math/*.test.ts src/components/visuals/*.test.ts",
    "part-d:preview": "node src/components/visuals/preview/serve.mjs",
    "part-d:e2e": "playwright test --config src/components/visuals/preview/playwright.config.ts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.173.0",
    "katex": "^0.19.1",
    "mafs": "^0.21.0",
    "mathjs": "^15.2.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "mafs": {
      "katex": "$katex"
    }
  }
}
