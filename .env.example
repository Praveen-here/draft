# Copy to .env.local and fill in. Never commit .env.local.
# Naming: SERVICE_KEY_ENV. APP_ENV picks which set the app uses.

APP_ENV=dev

GEMINI_KEY_DEV=
GRADIUM_KEY_DEV=
GROQ_KEY_DEV=

# Local Postgres for learner memory (what the tutor remembers about each student). Optional:
# without it the tutor works, just without memory. e.g. postgres://<user>:<password>@localhost:5432/draft
DATABASE_URL=

# Sign in with Google (Better Auth). Google Cloud Console → OAuth client (Web application) with
# origin http://localhost:3000 and redirect URI http://localhost:3000/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# tldraw canvas license. Not needed on localhost / `npm run dev`.
# REQUIRED for any HTTPS production deploy (e.g. Vercel): without it the canvas hides itself after 5 s.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Demo keys: only on the demo laptop / Vercel production. Don't use while building.
GEMINI_KEY_DEMO=
GRADIUM_KEY_DEMO=
GROQ_KEY_DEMO=
