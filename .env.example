# Copy to .env.local and fill in. Never commit .env.local.
# Naming: SERVICE_KEY_ENV. APP_ENV picks which set the app uses.

APP_ENV=dev

GEMINI_KEY_DEV=
GRADIUM_KEY_DEV=
GROQ_KEY_DEV=

# Demo keys: only on the demo laptop / Vercel production. Don't use while building.
GEMINI_KEY_DEMO=
GRADIUM_KEY_DEMO=
GROQ_KEY_DEMO=
